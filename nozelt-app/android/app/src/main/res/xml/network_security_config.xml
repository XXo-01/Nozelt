<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- UI/subscription traffic must be encrypted and use system trust roots.
         VPN transports use mihomo's own protocol/TLS implementation. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
